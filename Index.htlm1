<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Official Apex Rivals studio and racing game website." />
    <meta name="keywords" content="Apex Rivals, racing game, esports, motorsport, gaming website" />
    <meta property="og:title" content="Apex Rivals | Official Racing Game" />
    <meta property="og:description" content="Official studio and game website for Apex Rivals." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://apexrivals.racing/" />
    <title>Apex Rivals | Official Racing Game</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Apex Rivals home">
          <span class="brand-mark">AR</span>
          <span>Apex Rivals</span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <a href="#game">Game</a>
          <a href="#features">Features</a>
          <a href="privacy/">Privacy</a>
          <a href="terms/">Terms</a>
        </nav>
        <div class="nav-actions">
          <a class="btn btn-ghost" href="#features">Watch trailer</a>
          <a class="btn btn-primary" href="#launch">Play now</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Official studio and game website</p>
            <h1>Race beyond<br /><span>the finish line.</span></h1>
            <p class="lead">
              Apex Rivals is a modern competitive racing experience built for speed,
              precision, and unforgettable moments on the track.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#launch">Get the game</a>
              <a class="btn btn-secondary" href="#features">Explore features</a>
            </div>
            <ul class="stats" aria-label="Apex Rivals statistics">
              <li><strong>12+</strong><span>Tracks</span></li>
              <li><strong>4</strong><span>Modes</span></li>
              <li><strong>24/7</strong><span>Competition</span></li>
            </ul>
          </div>

          <div class="hero-visual" aria-label="Apex Rivals motion art">
            <div class="car-glow"></div>
            <div class="hud-card hud-top">
              <span>Track</span>
              <strong>Neon Circuit</strong>
            </div>
            <div class="hud-card hud-bottom">
              <span>Best lap</span>
              <strong>1:18.44</strong>
            </div>
          </div>
        </div>
      </section>

      <section id="game" class="intro panel">
        <div class="container intro-grid">
          <div>
            <p class="eyebrow">Built for players</p>
            <h2>Fast, fierce, and built for the next generation of racers.</h2>
          </div>
          <p>
            From street circuits to high-speed championship battles, Apex Rivals blends
            immersive racing physics with competitive progression, deep customization,
            and polished esports-ready gameplay.
          </p>
        </div>
      </section>

      <section id="features" class="features">
        <div class="container section-head">
          <p class="eyebrow">Core features</p>
          <h2>Choose your line.</h2>
        </div>

        <div class="container card-grid">
          <article class="feature-card">
            <span class="feature-badge">01</span>
            <h3>Career Sprint</h3>
            <p>Progress through tournaments, unlock upgrades, and dominate every circuit.</p>
          </article>

          <article class="feature-card">
            <span class="feature-badge">02</span>
            <h3>Time Attack</h3>
            <p>Chase perfect lines, race ghosts, and set new speed records.</p>
          </article>

          <article class="feature-card">
            <span class="feature-badge">03</span>
            <h3>League Battles</h3>
            <p>Climb leaderboards and prove your talent in elite competition.</p>
          </article>
        </div>
      </section>

      <section class="cta" id="launch">
        <div class="container cta-box">
          <div>
            <p class="eyebrow">Ready to compete?</p>
            <h2>Join the Apex Rivals community.</h2>
          </div>
          <div class="cta-actions">
            <a class="btn btn-primary" href="https://github.com/abuxone1/Apex-Rivals" target="_blank" rel="noreferrer">View project</a>
            <a class="btn btn-secondary" href="privacy/">Legal & privacy</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-wrap">
        <div>
          <a class="brand footer-brand" href="/">
            <span class="brand-mark">AR</span>
            <span>Apex Rivals</span>
          </a>
          <p>Official studio and game website.</p>
        </div>
        <div class="footer-links">
          <a href="#game">Game</a>
          <a href="#features">Features</a>
          <a href="privacy/">Privacy</a>
          <a href="terms/">Terms</a>
          <a href="data-deletion/">Data deletion</a>
        </div>
      </div>
      <div class="container copyright">
        <p>© <span id="year"></span> Apex Rivals. All rights reserved.</p>
      </div>
    </footer>

    <script src="script.js"></script>
  </body>
</html>